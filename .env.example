# Optional: enables live LLM synthesis. Without keys the app runs in DEMO / LOCAL KNOWLEDGE MODE.
# The backend does not load .env automatically — export these in your shell before starting uvicorn.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Production hardening (PyroLens 3.0). FLAMEWISE_* aliases remain supported for 2.x deployments.
# Comma-separated allowed browser origins (default: the Vite dev server).
PYROLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max /api/assistant requests per client per minute (protects a paid LLM key).
PYROLENS_AI_RATE_PER_MIN=20
PYROLENS_LOG_LEVEL=INFO
